                    type: string
                    format: alphanumeric
                  force:
                    $ref: '#/components/schemas/AgentInsertForce'
                required:
                  - name
              example:
                name: NewHost_2
                ip: 10.0.10.11
                id: "123"
                key: 1abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghi64
                force:
